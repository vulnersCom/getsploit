# Example variables for shells and runners that support dotenv files.
# Getsploit does not load .env automatically. Never commit a real key.
# Create a key at https://vulners.com/userinfo

# Vulners API key used for online search and database updates.
VULNERS_API_KEY=

# Optional. Directory for the local database and the legacy key file.
# Defaults to ~/.getsploit
# GETSPLOIT_HOME=
